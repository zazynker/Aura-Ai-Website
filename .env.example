# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Configuration
VITE_APP_URL=http://localhost:3000

# Optional dedicated one-shot Template product in Dodo Payments. Until set,
# Quick Use's $1.99 action uses the existing welcome-gift product as a safe
# fallback, so configure this before enabling paid one-click generation.
VITE_DODO_QUICK_USE_PRODUCT_ID=

# Server-only image providers (never prefix these with VITE_)
FAL_KEY=your-fal-key-here
EVOLINK_API_KEY=your-evolink-key-here

# Optional EvoLink Midjourney batch pricing overrides in USD
EVOLINK_MJ_STANDARD_USD=0.08
EVOLINK_MJ_HD_USD=0.12

# ============================================
# Instructions:
# ============================================
# 1. Copy this file to .env.local
# 2. Replace the values with your actual credentials
# 3. Never commit .env.local to version control
# Sentry Error Monitoring (Optional)
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Optional Cloudflare Turnstile site key. Also enable CAPTCHA and set the
# matching secret in Supabase Authentication > Bot and Abuse Protection.
VITE_TURNSTILE_SITE_KEY=
