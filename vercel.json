{
  "functions": {
    "api/finalize-workflow-video.ts": {
      "includeFiles": "node_modules/@ffmpeg-installer/**"
    }
  },
  "crons": [
    { "path": "/api/cleanup-template-uploads", "schedule": "17 3 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
